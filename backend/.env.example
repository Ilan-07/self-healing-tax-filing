DATABASE_URL=postgresql+psycopg://tax:tax@localhost:5432/tax_filing
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llama3.2-vision:latest
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
CHROMA_PATH=../storage/chroma
STORAGE_ROOT=../storage
VERIFICATION_THRESHOLD=0.95
MAX_REMEDIATION_ATTEMPTS=2
# State tax is opt-in; a single flat rate cannot model 40+ state systems.
DEFAULT_STATE_TAX_RATE=0.0
# E-file boundary: "pdf" (self-file) or "mock_transmitter" (simulated MeF).
EFILE_BACKEND=pdf
# W-2 extractor: "label" (offline parser) or "azure" (Document Intelligence).
W2_EXTRACTOR=label
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
TESSERACT_CMD=
# API key for the submission endpoints; empty disables auth (local dev only).
API_KEY=
LOG_LEVEL=INFO
